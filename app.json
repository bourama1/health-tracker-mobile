{
  "expo": {
    "name": "Health Tracker",
    "slug": "health-tracker-mobile",
    "version": "1.1.0",
    "description": "Comprehensive fitness and health tracking app with workout plans, body measurements, and sleep analysis.",
    "owner": "bourama1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "healthtracker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6200ee"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bourama1.healthtracker",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to take progress photos.",
        "NSPhotoLibraryUsageDescription": "This app uses the photo library to save and view progress photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#6200ee"
      },
      "intentFilters": [],
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "VIBRATE",
        "NOTIFICATIONS"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.bourama1.healthtracker",
      "softwareKeyboardLayoutMode": "pan",
      "playStoreRootCategories": ["HEALTH_AND_FITNESS"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5d8fa772-0a23-45a1-a54c-353eaf750e3f"
      }
    }
  }
}
